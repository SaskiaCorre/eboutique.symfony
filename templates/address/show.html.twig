{% extends 'base.html.twig' %}

{% block title %}Address{% endblock %}

{% block body %}
    <h1>Adresse</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ address.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ address.name }}</td>
            </tr>
            <tr>
                <th>Nom du client</th>
                <td>{{ address.clientName }}</td>
            </tr>
            <tr>
                <th>Rue</th>
                <td>{{ address.street }}</td>
            </tr>
            <tr>
                <th>CP</th>
                <td>{{ address.zipCode }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ address.city }}</td>
            </tr>
            <tr>
                <th>Pays</th>
                <td>{{ address.state }}</td>
            </tr>
            <tr>
                <th>Complément</th>
                <td>{{ address.moreDetails }}</td>
            </tr>
            <tr>
                <th>Updated_at</th>
                <td>{{ address.updatedAt ? address.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ address.createdAt ? address.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_address_index') }}">Retour</a>

    <a href="{{ path('app_address_edit', {'id': address.id}) }}">Modifier</a>

    {{ include('address/_delete_form.html.twig') }}
{% endblock %}
