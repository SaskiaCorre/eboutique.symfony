{% extends 'base.html.twig' %}

{% block title %}Formulaire adresse{% endblock %}

{% block body %}
    <h1>Formulaire adresse</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Nom de client</th>
                <th>Rue</th>
                <th>CP</th>
                <th>Ville</th>
                <th>Pays</th>
                <th>Complément</th>
                <th>Updated_at</th>
                <th>Created_at</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for address in addresses %}
            <tr>
                <td>{{ address.id }}</td>
                <td>{{ address.name }}</td>
                <td>{{ address.clientName }}</td>
                <td>{{ address.street }}</td>
                <td>{{ address.zipCode }}</td>
                <td>{{ address.city }}</td>
                <td>{{ address.state }}</td>
                <td>{{ address.moreDetails }}</td>
                <td>{{ address.updatedAt ? address.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ address.createdAt ? address.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_address_show', {'id': address.id}) }}">Lire</a>
                    <a href="{{ path('app_address_edit', {'id': address.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">Adresse non trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_address_new') }}">Créer une nouvelle adresse</a>
{% endblock %}
