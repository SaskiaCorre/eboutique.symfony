{% extends 'base.html.twig' %}

{% block title %}MaBoutique | Mon Panier{% endblock %}

{% block body %}
{% include "/page_head/page_head.html.twig" with {'page_name': 'Panier'} %}

<div class="main_content cart_content" data-cart="{{cart_json}}" data-carriers="{{carriers_json}}">
    <div class="section">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="table-responsive shop_cart_table">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="product-thumbnail">&nbsp;</th>
                                    <th class="product-name">Produit</th>
                                    <th class="product-price">Prix</th>
                                    <th class="product-quantity">Quantité</th>
                                    <th class="product-subtotal">Total</th>
                                    <th class="product-remove">Supprimer</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {# Ligne icone panier #}
            <div  class="row">
                <div  class="col-12">
                    <div class="medium_divider"></div>
                    <div class="divider center_icon">
                        <i class="ti-shopping-cart-full"></i>
                    </div>
                    <div class="medium_divider"></div>
                </div>
            </div>
            <div class="row">
                {# Encart transporteur = début du form carrier, titre inclus #}
                <div class="col-md-6">
                    <div class="border p-3 p-md-4 carrier_form">
                        <div class="heading_s1 mb-3">
                            <h6>Choississez votre transporteur</h6>
                                <p>Par défaut, nous avons sélectionné le moins honéreux
                                    <br>Pour modifier, sélectionnez le transporteur de votre choix et appuyez sur Modifier
                                </p>
                        </div>
                        <form action="/cart/carrier" method="post">
                            <select name="carrierId" value="{{cart.carrier.id}}" id="carrier" class="form-control">
                            </select>
                        </form>
                    </div>
                </div>
                {# Encart prix total #}
                <div class="col-md-6">
                    <div class="border p-3 p-md-4">
                        <div class="heading_s1 mb-3">
                            <h6>Total</h6>
                        </div>
                        <div class="table-responsive cart_table">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td class="cart_total_label">Sous-total</td>
                                        <td class="cart_sub_total_amount">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="cart_total_label">Frais de livraison</td>
                                        <td class="cart_shipping_total_amount">  </td>
                                    </tr>
                                    <tr>
                                        <td class="cart_total_label">Total</td>
                                        <td class="cart_total_amount"><strong>
                                        </strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div><a routerlink="/checkout" class="btn btn-fill-out"
                                 href="/checkout">Valider ma commande</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
